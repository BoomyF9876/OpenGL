#version 330 // OpenGL version 3.3 (minimum requirement)

in vec3 vertices;      // Values sent from application to this attribute
in vec3 normals;       // Normals for the vertices
in vec2 texCoords;     // Input Texture coordinates

uniform vec3 CameraPosition;   // Camera Position
uniform mat4 World;            // World Position
uniform mat4 MVP;              // World, View, Projection matrix

out vec3 retFragPos;           // Output for the fragment position
out vec3 retNormal;            // Output for the normals
out vec2 retTexCoord;          // Output the texture coordiates
out vec3 retViewDirection;     // View Direction relative to the FragPosition

void main()
{
    gl_Position = MVP * vec4(vertices, 1.0); // Transform the model to screen projection
    retNormal = normalize(mat3(transpose(inverse(World))) * normals);
    retTexCoord = texCoords;
    retFragPos = vec3(World * vec4(vertices, 1.0f));
    retViewDirection = normalize(CameraPosition - retFragPos);
}