#version 120 // OpenGL version 2.1 (minimum requirement)

uniform int RenderRedChannel;
uniform int RenderGreenChannel;
uniform int RenderBlueChannel;
uniform float Intensity;

void main()
{
    vec3 color = vec3(float(RenderRedChannel),float(RenderGreenChannel),float(RenderBlueChannel));
    color *= Intensity;
    gl_FragColor = vec4(color, 1.0);
}