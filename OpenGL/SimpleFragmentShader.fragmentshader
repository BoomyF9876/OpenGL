#version 120 // OpenGL version 2.1 (minimum requirement)

uniform int RenderRedChannel;
uniform int RenderGreenChannel;
uniform int RenderBlueChannel;
uniform float Intensity;

void main()
{
    gl_FragColor = vec4(RenderRedChannel,RenderGreenChannel,RenderBlueChannel, 1.0)*Intensity;// Set the output color by multiplying the input color by the intensity by percentage
}