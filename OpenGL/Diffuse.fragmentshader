#version 330 // OpenGL version 3.3 (minimum requirement)

in vec3 retFragPos;
in vec3 retNormal;
in vec2 retTexCoords;
in vec3 retViewDirection;

out vec4 FragColor;

struct Marterial
{
	sampler2D diffuseTexture;
	sampler2D specularTexture;
	float specularStrength;
};

struct Light
{
	vec3 position;
	vec3 direction;
	vec3 color;
	vec3 ambientColor;
	vec3 diffuseColor;
	vec3 specularColor;

	float constant;
	float linear;
	float quadratic;

	float coneAngle;
	float falloff;
};

uniform Marterial material;
#define NUM_LIGHTS 4
uniform Light light[NUM_LIGHTS];
uniform int numLights;

void main()
{
	vec4 finalColor = vec4(0);
	for(int i = 0; i < numLights; i++)
	{
		vec3 lightDir = normalize(light[i].position - retFragPos);

		float a = cos(light[i].coneAngle);
		float d = dot(normalize(light[i].direction), -lightDir);
		if (a < d)
		{
			float lambertianStrength = dot(lightDir, retNormal);

			vec3 refl = reflect(-lightDir, retNormal);
			float specularStrength = pow(max(dot(retViewDirection, refl), 0.0f), material.specularStrength);
	
			float distance = length(light[i].position - retFragPos);
			float att = 1.0f / (light[i].constant + light[i].linear * distance + light[i].quadratic * (distance * distance));
			att *= 1 - pow(a / d, light[i].falloff); 
			vec3 ambient = texture(material.diffuseTexture, retTexCoords).rgb * light[i].ambientColor;
			vec3 lambertian = lambertianStrength * texture(material.diffuseTexture, retTexCoords).rgb * light[i].diffuseColor * att;
			vec3 specular = specularStrength * texture(material.specularTexture, retTexCoords).rgb * light[i].specularColor * att;
	
			//FragColor = vec4(ambient + lambertian + specular, 1.0f);
			finalColor += vec4(ambient + lambertian + specular, 1.0f);
		}
		else
		{
			vec3 ambient = texture(material.diffuseTexture, retTexCoords).rgb * light[i].ambientColor / NUM_LIGHTS;
			finalColor += vec4(ambient, 1.0f);
		}
	}
	FragColor = finalColor;
}
	