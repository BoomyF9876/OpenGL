#version 330 core

in vec3 retFragPos;
in vec3 retNormal;
in vec2 retTexCoord;
in vec3 retViewDirection;
in mat3 retTBN;

out vec4 FragColor;

struct Marterial
{
    sampler2D diffuseTexture;
    sampler2D specularTexture;
    float specularStrength;
    sampler2D normalTexture;
};

struct Light
{
    int type; // 1 = directional, 2 = point, 3 = spot
    vec3 position;
    vec3 direction;
    vec3 color;
    vec3 ambientColor;
    vec3 diffuseColor;
    vec3 specularColor;
    float constant;
    float linear;
    float quadratic;
    float coneAngle;
    float falloff;
};

uniform Marterial material;
#define NUM_LIGHTS 4
uniform Light light[NUM_LIGHTS];
uniform int numLights;
uniform bool EnableNormalMaps = false;

vec3 CalculateDirectionalLight(Light light)
{
    vec3 lightDir = (-light.direction);
    float lambertianStrength = dot(lightDir, retNormal); // Get Lambertian effect
    
    // Calculate specular lighting
    vec3 refl = reflect(-lightDir, retNormal);
    float specularStrength = pow(max(dot(retViewDirection, refl), 0.0f), material.specularStrength);
    
    vec3 ambient = texture(material.diffuseTexture, retTexCoord).rgb * light.ambientColor;
    vec3 lambertian = lambertianStrength * texture(material.diffuseTexture, retTexCoord).rgb * light.diffuseColor;
    vec3 specular = specularStrength * texture(material.specularTexture, retTexCoord).rgb * light.specularColor;
    
    // Calculate final color
    return vec4(ambient + lambertian + specular, 1.0f);
}

vec3 CalculatePointLight(Light light)
{
    vec3 lightDir = normalize(light.position - retFragPos); // Normalize, for correct dot product results
    float lambertianStrength = max(dot(lightDir, retNormal), 0.0f); // Get Lambertian effect
    
    // Calculate specular lighting
    vec3 refl = reflect(-lightDir, retNormal);
    float specularStrength = pow(max(dot(retViewDirection, refl), 0.0f), material.specularStrength);
    
    // Calculate Point Lighting
    float distance = length(light.position - retFragPos);
    //float att = 1.0f / (light.constant + light.linear * distance + light.quadratic * (distance * distance));
    
    vec3 ambient = texture(material.diffuseTexture, retTexCoord).rgb * light.ambientColor;
    vec3 lambertian = lambertianStrength * texture(material.diffuseTexture, retTexCoord).rgb * light.diffuseColor;
    vec3 specular = specularStrength * texture(material.specularTexture, retTexCoord).rgb * light.specularColor;
    
    return vec4(ambient + lambertian + specular, 1.0f);
}

vec3 CalculateSpotLight(Light light)
{
    vec3 lightDir = normalize(light.position - retFragPos);

		float a = cos(light.coneAngle);
		float d = dot(normalize(light.direction), -lightDir);
		if (a < d)
		{
			float lambertianStrength = dot(lightDir, retNormal);

			vec3 refl = reflect(-lightDir, retNormal);
			float specularStrength = pow(max(dot(retViewDirection, refl), 0.0f), material.specularStrength);
	
			float distance = length(light.position - retFragPos);
			float att = 1.0f / (light.constant + light.linear * distance + light.quadratic * (distance * distance));
			att *= 1 - pow(a / d, light.falloff); 
			vec3 ambient = texture(material.diffuseTexture, retTexCoord).rgb * light.ambientColor / numLights;
			vec3 lambertian = lambertianStrength * texture(material.diffuseTexture, retTexCoord).rgb * light.diffuseColor * att;
			vec3 specular = specularStrength * texture(material.specularTexture, retTexCoord).rgb * light.specularColor * att;
	
			//FragColor = vec4(ambient + lambertian + specular, 1.0f);
			//finalColor += vec4(ambient + lambertian + specular, 1.0f);
            return ambient + lambertian + specular;
		}
		else
		{
			vec3 ambient = texture(material.diffuseTexture, retTexCoord).rgb * light.ambientColor / numLights;
			//finalColor += vec4(ambient, 1.0f);
            return ambient;
		}

}

void main()
{
    vec4 diffColor = texture(material.diffuseTexture, retTexCoord);
    if (diffColor.a == 0)
    {
        discard;
    }

    vec4 finalColor = vec4(0);
    for(int i = 0; i < numLights; i++)
    {
        // Calculte lambertian strength
        vec3 lightDir = normalize(light[i].position - retFragPos);
        
        vec3 normal = retNormal;
        if (EnableNormalMaps == true)
        {
            normal = texture(material.normalTexture, retTexCoord).rgb;
            normal = normal * 2.0 - 1.0;
            normal = normalize(retTBN * normal);
        }
        float lambertianStrength = max(dot(lightDir, normal), 0.0f);
        
        // Calculate specular strength
        vec3 refl = reflect(-lightDir, normal);
        float specularStrength = pow(max(dot(retViewDirection, refl), 0.0f), material.specularStrength);
        
        vec3 ambient = diffColor.rgb * light[i].ambientColor / 1;
        vec3 lambertian = lambertianStrength * diffColor.rgb * light[i].diffuseColor;
        vec3 specular = specularStrength * texture(material.specularTexture, retTexCoord).rgb * light[i].specularColor;
        finalColor += vec4(ambient + lambertian + specular, 1.0f);
    }
    FragColor = vec4(finalColor.rgb, diffColor.a);
}