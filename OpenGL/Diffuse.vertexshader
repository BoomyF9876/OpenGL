#version 330 // OpenGL version 3.3 (minimum requirement)

in vec3 vertices;
in vec3 normals;
in vec2 texCoords;
layout (location =10) in mat4 instanceMatrix; // Example of instanced matrix attribute

uniform mat4 model;
uniform vec3 CameraPosition;
uniform mat4 World;
uniform mat4 WVP;
uniform bool EnableInstancing =false;

out vec3 retFragPos;
out vec3 retNormal;
out vec2 retTexCoords;
out vec3 retViewDirection;

void main()
{
	mat4 world = World;
	if (EnableInstancing)
	{
		world *= instanceMatrix;
		gl_Position = WVP * instanceMatrix * vec4(vertices, 1.0f);
	}
	else
	{
		gl_Position = WVP * model * vec4(vertices, 1.0f);
	}

	retNormal = normalize(mat3(transpose(inverse(world))) * normals);
	retTexCoords = texCoords;
	retFragPos = vec3(world * vec4(vertices, 1.0f));
	retViewDirection = normalize(CameraPosition - retFragPos);
}