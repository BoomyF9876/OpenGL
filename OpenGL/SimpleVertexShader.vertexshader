#version 330 // OpenGL version 3.3 (minimum requirement)

in vec3 vertices; // Value sent from application to this attribute
in vec3 colors; // Value sent from application to this attribute
in vec2 texCoords;
in vec2 texScroll; // Scrolling texture offset

uniform mat4 WVP; // Model-View-Projection matrix sent from application to this uniform

out vec3 retColor; // Output variable for fragment shader
out vec2 retTexCoord;

void main()
{
	gl_Position = WVP * vec4(vertices,1.0); // Pass-through, shader, pass positions to next shader
	retColor = colors; 
	retTexCoord = texCoords + texScroll; // Add scrolling offset to texture coordinates
}